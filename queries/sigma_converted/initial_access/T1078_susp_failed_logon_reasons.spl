source="WinEventLog:Security" EventCode IN (4625, 4776) (Status IN ("0xC0000072", "0xC000006F", "0xC0000070", "0xC0000413", "0xC000018C", "0xC000015B") OR Sub_Status IN ("0xC0000072", "0xC000006F", "0xC0000070", "0xC0000413", "0xC000018C", "0xC000015B")) NOT Security_ID="S-1-0-0" | table Account_Name,Account_Domain,Security_ID,Status,Sub_Status,Source_Network_Address,Workstation_Name,ComputerName
