source="WinEventLog:Security" EventCode=4698 (Message="*<Command>cmd.exe</Command>*" OR Message="*<Command>cmd</Command>*" OR Message="*powershell*" OR Message="*pwsh*" OR Message="*mshta*" OR Message="*wscript*" OR Message="*cscript*" OR Message="*rundll32*" OR Message="*regsvr32*" OR Message="*certutil*" OR Message="*bitsadmin*" OR Message="*wmic*" OR Message="*bash*" OR Message="*forfiles*") | table Task_Name,Account_Name,ComputerName
