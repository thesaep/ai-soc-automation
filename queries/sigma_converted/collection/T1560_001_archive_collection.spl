source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\tar.exe" OR OriginalFileName="bsdtar" OR Image="*\\7z.exe" OR Image="*\\7za.exe" OR Image="*\\7zr.exe" OR Image="*\\7zg.exe" OR OriginalFileName="7z.exe" OR OriginalFileName="7za.exe" OR OriginalFileName="7zG.exe" OR Image="*\\rar.exe" OR Image="*\\winrar.exe" OR Image="*\\WinRAR.exe" OR OriginalFileName="Rar.exe" OR OriginalFileName="WinRAR" OR Image="*\\makecab.exe" OR OriginalFileName="makecab.exe" OR CommandLine="*Compress-Archive*") (CommandLine="*\\Temp\\*" OR CommandLine="*\\AppData\\*" OR CommandLine="*\\Users\\*" OR CommandLine="* a -hp*" OR CommandLine="* a -p*" OR CommandLine="*-cf *" OR CommandLine="*.7z*" OR CommandLine="*.rar*") NOT ParentImage="*\\splunk*" | dedup Image CommandLine User ComputerName
| table Image,OriginalFileName,CommandLine,User,ParentImage,ProcessId,ComputerName
